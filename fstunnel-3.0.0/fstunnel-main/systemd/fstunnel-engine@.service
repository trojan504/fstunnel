[Unit]
Description=fstunnel engine tunnel %i
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/local/lib/fstunnel/fstunnel-kernel up %i
ExecStart=/usr/local/bin/fstunnel-engine -config /etc/fstunnel/tunnels/%i.env
ExecStopPost=/usr/local/lib/fstunnel/fstunnel-kernel down %i
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
